    {
      "parameters": {
        "jsCode": "const data = $('Detectar Anomalías').first().json;\nconst ahora = new Date().toISOString();\nconst criticas = data.anomalias.filter(a => a.severidad === 'critica');\nconsole.log(`[${ahora}] ANOMALIAS CRITICAS: ${criticas.length}`);\nreturn [{ json: { timestamp: ahora, total: data.total_anomalias, criticas: criticas.length, detalle: criticas } }];"
      },
      "id": "5ba96e14-e455-4adb-b09f-c13313622b5d",
      "name": "Procesar Críticas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $('Detectar Anomalías').first().json;\nconst ahora = new Date().toISOString();\nconsole.log(`[${ahora}] Sin anomalias criticas`);\nreturn [{ json: { timestamp: ahora, status: 'sin_criticas', resumen: data.por_severidad } }];"
      },
      "id": "704aebb0-a460-4ba1-a5a7-d4cc19cc113d",
      "name": "Sin Críticas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst nivel = input.criticas >= 3 ? 'CRITICO' : 'ALTO';\nreturn [{ json: { ...input, nivel_riesgo: nivel, accion: nivel === 'CRITICO' ? 'Revision inmediata' : 'Monitorear' } }];"
      },
      "id": "7709a314-107c-4352-af5e-9b4fa79e972a",
      "name": "Clasificar Riesgo",
