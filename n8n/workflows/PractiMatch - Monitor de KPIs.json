    {
      "parameters": {
        "jsCode": "const kpis = $('Obtener KPIs').first().json.kpis;\nconst ahora = new Date().toISOString();\n\nconsole.log(`[${ahora}] ✅ Sistema OK - Tasa éxito: ${kpis.tasa_exito}% | Matches: ${kpis.total_matches}`);\n\nreturn [{ json: { status: 'ok', timestamp: ahora, kpis } }];"
      },
      "id": "f283d603-cc5c-4e09-a719-612e775f8649",
      "name": "Sistema OK",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "const kpis = $('Obtener KPIs').first().json.kpis;\nconst alertas = $input.first().json.alertas || [];\nconst ahora = new Date().toISOString();\n\nconsole.log(`[${ahora}] ⚠️ ALERTA - Tasa éxito: ${kpis.tasa_exito}% | Anomalías críticas: ${kpis.anomalias_criticas}`);\nconsole.log(`Total alertas generadas: ${alertas.length}`);\n\nreturn [{ \n  json: { \n    status: 'alerta',\n    timestamp: ahora,\n    motivo: kpis.tasa_exito < 20 ? 'Tasa de éxito crítica' : 'Demasiadas anomalías críticas',\n    kpis,\n    alertas \n  } \n}];"
      },
      "id": "e4130f13-6836-41cd-90b4-19e606b09723",
      "name": "Procesar Alerta",
      "type": "n8n-nodes-base.code",
