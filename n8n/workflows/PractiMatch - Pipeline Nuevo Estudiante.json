    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\n// Validar que vengan los datos mínimos\nif (!body.estudiante_id) {\n  throw new Error('estudiante_id es requerido');\n}\n\nconsole.log(`Nuevo estudiante recibido: ID ${body.estudiante_id}`);\n\nreturn [{ json: { estudiante_id: body.estudiante_id, nombre: body.nombre || 'Sin nombre', timestamp: new Date().toISOString() } }];"
      },
      "id": "588679c2-e74d-4634-be6e-12bf63ef5ad2",
      "name": "Validar Datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
