        224,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://practicas_api:5000/api/calcular-matches",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ estudiante_id: $json.estudiante_id }) }}",
        "options": {}
      },
      "id": "a7bfda4c-08b1-4073-bb07-89687f381ba3",
      "name": "Calcular Matches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const matchData = $('Calcular Matches').first().json;\nconst estudianteData = $('Validar Datos').first().json;\nconst ahora = new Date().toISOString();\n\nconst topMatches = (matchData.matches || []).slice(0, 3).map(m => ({\n  empresa: m.empresa_nombre,\n  area: m.empresa_area,\n  score: m.score_final\n}));\n\nconsole.log(`Matches calculados para estudiante ${estudianteData.estudiante_id}: ${matchData.num_matches} empresas compatibles`);\ntopMatches.forEach((m, i) => console.log(`  ${i+1}. ${m.empresa} - Score: ${m.score}%`));\n\nreturn [{ \n  json: { \n    timestamp: ahora,\n    estudiante_id: estudianteData.estudiante_id,\n    nombre: estudianteData.nombre,\n    total_matches: matchData.num_matches,\n    top_3_empresas: topMatches,\n    status: 'matches_calculados'\n  } \n}];"
      },
